---
const stats = [
  { n: 50, unit: "%", label: "Proteína",   sub: "Saciedad real entre comidas.", sello: "Por paquete", c: "var(--dorado)" },
  { n: 0,  unit: " g", label: "Azúcar",    sub: "Cero azúcar agregada.",        sello: "Sin vueltas", c: "var(--pimienta)" },
  { n: 286, unit: "", label: "Calorías",   sub: "Energía para moverte.",         sello: "Por paquete", c: "var(--picante)" },
  { n: null, prefix: "GLUTEN", unit: "FREE", label: "Sin TACC", sub: "Carne, sidra y sal.", sello: "Sin TACC", c: "var(--ajo)" },
];
---
<section class="porque" id="porque">
  <div class="wrap">
    <div style="max-width:1200px;margin:0 auto">
      <span class="pill" style="--c:var(--ajo)">¿Por qué Kichar?</span>
      <h2 class="disp" style="margin-top:18px">Pocos ingredientes.<br />Mucha proteína.</h2>
    </div>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <div class="sello" style={`--c:${s.c}`}>{s.sello}</div>
          <div class="n">
            {s.n !== null
              ? <><span class="cnt" data-to={s.n}>{s.n}</span>{s.unit && <span class="unit">{s.unit}</span>}</>
              : s.prefix
                ? <div class="gf-stack"><span class="gf-top">{s.prefix}</span><span class="gf-free">{s.unit}</span></div>
                : <span class="unit-main">{s.unit}</span>}
          </div>
          <b>{s.label}</b>
          <span>{s.sub}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="cintas" aria-hidden="true">
    <div class="cinta a">
      <div class="in">Sin azúcar ✦ Gluten free ✦ 50% proteína ✦ Snack natural ✦ Sin azúcar ✦ Gluten free ✦ 50% proteína ✦ Snack natural ✦</div>
    </div>
    <div class="cinta b">
      <div class="in">Carne posta ✦ Versión snack ✦ Carne posta ✦ Versión snack ✦ Carne posta ✦ Versión snack ✦ Carne posta ✦</div>
    </div>
  </div>
</section>

<style>
.porque {
  position: relative;
  padding-block: 120px 160px;
  overflow: hidden;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  max-width: 1200px;
  margin: 56px auto 0;
}

.stat {
  position: relative;
  padding: 22px 18px;
  border: 3px solid var(--tinta);
  border-radius: 18px;
  background: var(--crema);
}

.stat .n {
  font-family: var(--display);
  font-weight: 400;
  font-size: clamp(4rem, 7.5vw, 10rem);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  display: flex;
  align-items: flex-start;
  gap: .04em;
}

/* .cnt hereda tamaño de .n; .stat span no debe pisarlo */
.stat .cnt {
  font-size: inherit;
  color: inherit;
}

.stat .unit {
  font-size: .28em;
  line-height: 1.8;
  padding-top: .08em;
}

.gf-stack {
  display: flex;
  flex-direction: column;
  line-height: .95;
}

.gf-top {
  font-size: .2em;
  font-family: var(--display);
  font-weight: 400;
  letter-spacing: .07em;
  text-transform: uppercase;
  padding-bottom: .15em;
  opacity: .7;
}

.gf-free {
  font-size: inherit;
  color: inherit;
  line-height: 1;
}

.stat b {
  display: block;
  font-family: var(--display);
  text-transform: uppercase;
  font-weight: 400;
  margin-top: 6px;
}

.stat span {
  font-size: .9rem;
  color: var(--tinta-2);
}

.sello {
  position: absolute;
  top: -22px;
  right: -14px;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  text-align: center;
  font-family: var(--display);
  font-weight: 400;
  font-size: 10px;
  line-height: 1.05;
  text-transform: uppercase;
  background: var(--c);
  border: 2px solid var(--tinta);
}

.cintas {
  position: relative;
  height: 230px;
  margin-top: 90px;
}

.cinta {
  position: absolute;
  left: -10%;
  width: 120%;
  white-space: nowrap;
  overflow: hidden;
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: clamp(1.6rem, 3.6vw, 3rem);
  padding-block: 10px;
  border-block: 3px solid var(--tinta);
}

.cinta.a { top: 30px;  rotate: -4deg; background: var(--dorado); }
.cinta.b { top: 110px; rotate:  3deg; background: var(--pimienta); }

@media (max-width: 820px) {
  .porque { padding-block: 72px 80px; }
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat .n { font-size: clamp(2.8rem, 14vw, 5rem); }
  .sello { right: 6px; top: -16px; width: 56px; height: 56px; font-size: 9px; }
}
</style>
