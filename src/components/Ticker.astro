---
const items = [
  "Carne posta, versión snack",
  "50% proteína",
  "Nuevo: sabor Pimienta Negra",
  "Envíos a todo el país",
  "Sin azúcar agregada",
  "Gluten free",
];
---
<div class="ticker" aria-label="Banner promocional">
  <div class="track">
    <div class="row" aria-hidden="true">
      {items.map((t) => <span>{t}</span>)}
      {items.map((t) => <span>{t}</span>)}
      {items.map((t) => <span>{t}</span>)}
    </div>
    <div class="row" aria-hidden="true">
      {items.map((t) => <span>{t}</span>)}
      {items.map((t) => <span>{t}</span>)}
      {items.map((t) => <span>{t}</span>)}
    </div>
  </div>
</div>

<style>
.ticker {
  position: relative;
  z-index: 30;
  background: var(--tinta);
  color: var(--crema);
  overflow: hidden;
  white-space: nowrap;
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: 14px;
  padding-block: 8px;
}

.track {
  display: inline-flex;
  animation: tick 30s linear infinite;
  will-change: transform;
}

.row {
  display: inline-flex;
  gap: 32px;
  padding-right: 32px;
  flex-shrink: 0;
}

.row span::after {
  content: "✦";
  margin-left: 32px;
  color: var(--dorado);
}

@keyframes tick {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
</style>
