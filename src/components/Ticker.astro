---
---
<div class="ticker" aria-label="Banner promocional">
  <div class="track">
    <div class="row">
      <span>Carne posta, versión snack</span>
      <span>50% proteína</span>
      <span>Nuevo: sabor Pimienta Negra</span>
      <span>Envíos a todo el país</span>
    </div>
    <div class="row" aria-hidden="true">
      <span>Carne posta, versión snack</span>
      <span>50% proteína</span>
      <span>Nuevo: sabor Pimienta Negra</span>
      <span>Envíos a todo el país</span>
    </div>
  </div>
</div>

<style>
.ticker {
  position: relative;
  z-index: 30;
  background: var(--tinta);
  color: var(--crema);
  overflow: hidden;
  white-space: nowrap;
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: 14px;
  padding-block: 8px;
}

.track {
  display: inline-flex;
  animation: tick 24s linear infinite;
}

.row {
  display: inline-flex;
  gap: 28px;
  padding-right: 28px;
}

.row span::after {
  content: "✦";
  margin-left: 28px;
  color: var(--dorado);
}

@keyframes tick {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
</style>
