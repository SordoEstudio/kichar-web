---
const packs = [
  { src: "/img/pack-hot-chili.png",      alt: "Hot Chili" },
  { src: "/img/pack-dulce-picante.png",  alt: "Dulce Picante" },
  { src: "/img/pack-picante.png",        alt: "Picante" },
  { src: "/img/pack-pimienta.png",       alt: "Pimienta Negra" },
  { src: "/img/pack-ajo.png",            alt: "Ajo" },
  { src: "/img/pack-clasico.png",        alt: "Clásico" },
];
---
<section class="distri wrap" id="distribuidores">
  <div class="distri-cab">
    <span class="pill" style="--c:var(--dorado);color:var(--tinta)">Distribuidores y puntos de venta</span>
    <h2 class="disp">Llevá Kichar<br /><span class="r">a tu góndola</span></h2>
  </div>
  <div class="grid">
    <div class="abanico" aria-hidden="true">
      {packs.map((p) => <img src={p.src} alt={p.alt} />)}
    </div>
    <div class="distri-form">
      <p class="lead">
        Gimnasios, almacenes, dietéticas, kioscos y distribuidores.
        Dejanos tus datos y te enviamos la propuesta comercial.
      </p>
      <form id="form-distri" novalidate>

        <div class="campo">
          <input id="f-nombre" name="nombre" type="text" required autocomplete="organization" placeholder=" " />
          <label for="f-nombre">Nombre o comercio</label>
        </div>

        <div class="campo campo--sel" id="campo-tipo">
          <div class="csel" id="csel-tipo" role="combobox" aria-haspopup="listbox" aria-expanded="false" tabindex="0">
            <span class="csel__val"></span>
            <svg class="csel__arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <label class="flabel">Tipo de negocio</label>
          <ul class="csel__list" role="listbox" aria-label="Tipo de negocio" hidden>
            <li role="option" data-val="Gimnasio">Gimnasio</li>
            <li role="option" data-val="Dietética">Dietética</li>
            <li role="option" data-val="Almacén / kiosco">Almacén / kiosco</li>
            <li role="option" data-val="Distribuidor">Distribuidor</li>
          </ul>
          <input type="hidden" name="tipo" />
        </div>

        <div class="campo">
          <input id="f-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder=" " />
          <label for="f-ciudad">Ciudad</label>
        </div>

        <div class="campo">
          <input id="f-contacto" name="contacto" type="text" autocomplete="tel" placeholder=" " />
          <label for="f-contacto">Teléfono o email</label>
        </div>

        <button class="btn" type="submit">Quiero ser punto de venta</button>
        <span class="ok-msg" id="ok-msg" role="status" hidden>
          ¡Listo! Te contactamos pronto.
        </span>
      </form>
    </div>
  </div>
</section>

<script>
  // Submit
  const form = document.getElementById('form-distri');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = document.getElementById('ok-msg') as HTMLElement;
    msg.hidden = false;
  });

  // Custom select
  const campoSel = document.getElementById('campo-tipo') as HTMLElement;
  const csel     = document.getElementById('csel-tipo')  as HTMLElement;
  const cselVal  = csel?.querySelector('.csel__val')      as HTMLElement;
  const cselList = campoSel?.querySelector('.csel__list') as HTMLElement;
  const hiddenIn = campoSel?.querySelector('input[type="hidden"]') as HTMLInputElement;

  function openSel() {
    csel.classList.add('open');
    csel.setAttribute('aria-expanded', 'true');
    cselList.removeAttribute('hidden');
    campoSel.classList.add('open');
  }
  function closeSel() {
    csel.classList.remove('open');
    csel.setAttribute('aria-expanded', 'false');
    cselList.setAttribute('hidden', '');
    campoSel.classList.remove('open');
  }

  csel?.addEventListener('click', () =>
    csel.getAttribute('aria-expanded') === 'true' ? closeSel() : openSel()
  );

  csel?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); csel.click(); }
    if (e.key === 'Escape') closeSel();
  });

  cselList?.addEventListener('click', (e) => {
    const opt = (e.target as HTMLElement).closest('[role="option"]') as HTMLElement;
    if (!opt) return;
    const val = opt.dataset.val ?? '';
    cselVal.textContent = val;
    hiddenIn.value = val;
    campoSel.classList.add('has-val');
    cselList.querySelectorAll('[role="option"]').forEach(o => o.removeAttribute('aria-selected'));
    opt.setAttribute('aria-selected', 'true');
    closeSel();
    csel.focus();
  });

  document.addEventListener('click', (e) => {
    if (!campoSel?.contains(e.target as Node)) closeSel();
  });
</script>

<style>
.distri {
  position: relative;
  background: var(--tinta);
  color: var(--crema);
  padding-block: 100px 120px;
  overflow: hidden;
}

.distri-cab {
  max-width: 1200px;
  margin: 0 auto 64px;
}

.distri-cab h2 {
  font-size: clamp(3rem, 6.5vw, 6rem);
  margin-top: 18px;
  line-height: 1;
}

.distri-cab h2 .r {
  display: block;
  text-align: right;
}

.distri .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  max-width: 1200px;
  margin: 0 auto;
  align-items: center;
}

.abanico {
  position: relative;
  height: 440px;
}

.abanico img {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 200px;
  translate: -50% 0;
  transform-origin: 50% 120%;
  filter: drop-shadow(0 20px 20px #0006);
}

form {
  display: grid;
  gap: 14px;
  margin-top: 24px;
  max-width: 460px;
}

/* ---- Floating label inputs ---- */
.campo { position: relative; }

.campo input {
  width: 100%;
  font: inherit;
  font-size: 16px;
  padding: 16px 12px 10px;
  border-radius: 10px;
  border: 2px solid rgba(250,249,239,.3);
  background: transparent;
  color: var(--crema);
  display: block;
  transition: border-color .2s;
}

.campo input::placeholder { color: transparent; }

.campo input:focus { outline: none; border-color: var(--crema); }

.campo > label {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--body);
  font-size: 15px;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
  color: rgba(250,249,239,.45);
  pointer-events: none;
  background: var(--tinta);
  padding: 0 4px;
  line-height: 1;
  transition: top .15s, font-size .15s, color .15s, letter-spacing .15s;
}

.campo input:focus + label,
.campo input:not(:placeholder-shown) + label {
  top: 0;
  font-size: 11px;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: rgba(250,249,239,.65);
}

.campo input:focus + label { color: var(--dorado); }

/* ---- Custom select ---- */
.campo--sel { position: relative; }

.csel {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 12px 10px;
  border-radius: 10px;
  border: 2px solid rgba(250,249,239,.3);
  color: rgba(250,249,239,.45);
  cursor: pointer;
  user-select: none;
  min-height: 52px;
  transition: border-color .2s, color .2s;
}

.csel:focus,
.csel.open {
  outline: none;
  border-color: var(--crema);
  color: var(--crema);
}

.campo--sel.has-val .csel { color: var(--crema); }

.csel__arrow {
  flex-shrink: 0;
  transition: rotate .2s;
}

.csel.open .csel__arrow { rotate: 180deg; }

.campo--sel .flabel {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--body);
  font-size: 15px;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
  color: rgba(250,249,239,.45);
  pointer-events: none;
  background: var(--tinta);
  padding: 0 4px;
  line-height: 1;
  transition: top .15s, font-size .15s, color .15s, letter-spacing .15s;
}

.campo--sel.has-val .flabel,
.campo--sel.open .flabel {
  top: 0;
  font-size: 11px;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: rgba(250,249,239,.65);
}

.campo--sel.open .flabel { color: var(--dorado); }

.csel__list {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  background: #201c18;
  border: 2px solid rgba(250,249,239,.3);
  border-radius: 10px;
  z-index: 50;
  margin: 0;
  padding: 6px 0;
  list-style: none;
  overflow: hidden;
}

.csel__list[hidden] { display: none; }

.csel__list li {
  padding: 11px 14px;
  color: var(--crema);
  font-family: var(--body);
  font-size: 15px;
  cursor: pointer;
  transition: background .12s, color .12s;
}

.csel__list li:hover { background: var(--dorado); color: var(--tinta); }
.csel__list li[aria-selected="true"] { background: rgba(234,171,51,.18); }

.btn {
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  background: var(--dorado);
  color: var(--tinta);
  border: 0;
  border-radius: 12px;
  padding: 14px 18px;
  cursor: pointer;
  font-size: 1rem;
  margin-top: 4px;
  transition: opacity .15s;
}

.btn:hover { opacity: .9; }

.ok-msg {
  font-family: var(--body);
  font-size: 13px;
  color: var(--pimienta);
  font-weight: 600;
}

@media (max-width: 820px) {
  .distri { padding-block: 72px 80px; }
  .distri .grid { grid-template-columns: 1fr; }
  .abanico { height: 330px; }
  .abanico img { width: 150px; }
  .distri-cab h2 { font-size: clamp(2.4rem, 8vw, 4rem); }
}
</style>
