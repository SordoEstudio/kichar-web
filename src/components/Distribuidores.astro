---
const packs = [
  { src: "/img/pack-hot-chili.png",      alt: "Hot Chili" },
  { src: "/img/pack-dulce-picante.png",  alt: "Dulce Picante" },
  { src: "/img/pack-picante.png",        alt: "Picante" },
  { src: "/img/pack-pimienta.png",       alt: "Pimienta Negra" },
  { src: "/img/pack-ajo.png",            alt: "Ajo" },
  { src: "/img/pack-clasico.png",        alt: "Clásico" },
];
---
<section class="distri wrap" id="distribuidores">
  <div class="distri-cab">
    <span class="pill" style="--c:var(--dorado);color:var(--tinta)">Distribuidores y puntos de venta</span>
    <h2 class="disp">Llevá Kichar<br />a tu góndola</h2>
  </div>
  <div class="grid">
    <div class="abanico" aria-hidden="true">
      {packs.map((p) => <img src={p.src} alt={p.alt} />)}
    </div>
    <div class="distri-form">
      <p class="lead">
        Gimnasios, almacenes, dietéticas, kioscos y distribuidores.
        Dejanos tus datos y te enviamos la propuesta comercial.
      </p>
      <form id="form-distri" novalidate>
        <label for="f-nombre">
          Nombre o comercio
          <input id="f-nombre" name="nombre" type="text" required autocomplete="organization" placeholder="Ej: Dietética El Molino" />
        </label>
        <label for="f-tipo">
          Tipo de negocio
          <select id="f-tipo" name="tipo">
            <option>Gimnasio</option>
            <option>Dietética</option>
            <option>Almacén / kiosco</option>
            <option>Distribuidor</option>
          </select>
        </label>
        <label for="f-ciudad">
          Ciudad
          <input id="f-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder="Ej: Rafaela, Santa Fe" />
        </label>
        <button class="btn" type="submit">Quiero ser punto de venta</button>
        <span class="ok-msg" id="ok-msg" role="status" hidden>
          ¡Listo! Te contactamos pronto.
        </span>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('form-distri');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = document.getElementById('ok-msg') as HTMLElement;
    msg.hidden = false;
    msg.textContent = '¡Listo! Te contactamos pronto.';
  });
</script>

<style>
.distri {
  position: relative;
  background: var(--tinta);
  color: var(--crema);
  padding-block: 100px 120px;
  overflow: hidden;
}

.distri-cab {
  max-width: 1200px;
  margin: 0 auto 64px;
}

.distri-cab h2 {
  font-size: clamp(3rem, 6.5vw, 6rem);
  margin-top: 18px;
  line-height: 1;
}

.distri .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  max-width: 1200px;
  margin: 0 auto;
  align-items: center;
}

.abanico {
  position: relative;
  height: 440px;
}

.abanico img {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 200px;
  translate: -50% 0;
  transform-origin: 50% 120%;
  filter: drop-shadow(0 20px 20px #0006);
}

form {
  display: grid;
  gap: 12px;
  margin-top: 24px;
  max-width: 460px;
}

label {
  font-family: var(--body);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .08em;
  display: grid;
  gap: 4px;
}

input,
select {
  font: inherit;
  font-size: 16px;
  padding: 12px;
  border-radius: 10px;
  border: 2px solid var(--crema);
  background: transparent;
  color: var(--crema);
}

select option { color: var(--tinta); }

input::placeholder { color: #ffffff55; }

.btn {
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  background: var(--dorado);
  color: var(--tinta);
  border: 0;
  border-radius: 12px;
  padding: 14px 18px;
  cursor: pointer;
  font-size: 1rem;
  margin-top: 4px;
  transition: opacity .15s;
}

.btn:hover { opacity: .9; }

.ok-msg {
  font-family: var(--body);
  font-size: 13px;
  color: var(--pimienta);
  font-weight: 600;
}

@media (max-width: 820px) {
  .distri .grid { grid-template-columns: 1fr; }
  .abanico { height: 330px; }
  .abanico img { width: 150px; }
  .distri-cab h2 { font-size: clamp(2.4rem, 8vw, 4rem); }
}
</style>
