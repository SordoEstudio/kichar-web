---
---
<footer class="pie wrap" id="contacto">
  <div class="redes">
    <span style="--c:var(--dorado)"   data-handle="@kichar.snack">Instagram</span>
    <span style="--c:var(--pimienta)" data-handle="+54 9 XXX XXX XXXX">WhatsApp</span>
    <span style="--c:var(--ajo)"      data-handle="hola@kicharsnack.com.ar">Contacto</span>
    <span style="--c:var(--picante)"  data-handle="kicharsnack.com.ar">Web</span>
  </div>
  <div class="logo-bottom">
    <img src="/img/logo-kichar-final.png" alt="Kichar Snack" />
  </div>
  <div class="credits">
    © 2026 Kichar Snack · Diseño <b>Chiare Estudio</b> · Desarrollo <b>Harvi Digital</b>
  </div>
</footer>

<style>
.pie {
  position: relative;
  background: var(--tinta);
  color: var(--crema);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding-block: 28px;
  overflow: hidden;
  text-align: center;
}

.pie .redes {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 20px;
}

.pie .redes span {
  position: relative;
  border: 2px solid var(--c, var(--crema));
  border-radius: 999px;
  padding: 8px 16px;
  font-family: var(--display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: .85rem;
  cursor: pointer;
  transition: background .2s, color .2s, border-color .2s;
  overflow: visible;
}

/* Tooltip handle */
.pie .redes span::before {
  content: attr(data-handle);
  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  background: var(--c, var(--crema));
  color: var(--tinta);
  font-family: var(--body);
  font-size: 11px;
  font-weight: 700;
  text-transform: none;
  letter-spacing: 0;
  white-space: nowrap;
  padding: 5px 12px;
  border-radius: 20px;
  pointer-events: none;
  opacity: 0;
  scale: 0.8;
  transition:
    opacity .18s .04s,
    scale .28s .04s cubic-bezier(.34,1.56,.64,1),
    transform .28s .04s cubic-bezier(.34,1.56,.64,1);
  z-index: 10;
}

.pie .redes span:hover::before {
  opacity: 1;
  scale: 1;
  transform: translateX(-50%) translateY(0px);
}

/* Ripple onda */
.pie .redes span::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 999px;
  border: 2px solid currentColor;
  opacity: 0;
  pointer-events: none;
}

.pie .redes span:hover::after {
  animation: onda .55s ease-out forwards;
}

@keyframes onda {
  from { scale: 1;   opacity: .65; }
  to   { scale: 1.6; opacity: 0;   }
}

/* Hover por red */
.pie .redes span:hover { background: var(--c); color: var(--tinta); border-color: var(--c); }

/* Logo grande al fondo */
.logo-bottom {
  display: flex;
  justify-content: center;
}

.logo-bottom img {
  width: clamp(320px, 58vw, 860px);
  height: auto;
  opacity: .92;
}

/* Créditos */
.credits {
  font-family: var(--body);
  font-size: 12px;
  opacity: .45;
  margin-top: 28px;
  letter-spacing: .04em;
}

.credits b {
  font-weight: 600;
  opacity: .8;
}
</style>
