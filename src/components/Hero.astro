---
---
<section class="hero" id="inicio">
  <div class="fondo capa" data-vel="0.1"></div>

  <div class="marca capa" data-vel="-0.25">
    <img src="/img/logo-dark.png" alt="Kichar Snack" />
  </div>

  <img class="pouch capa" src="/img/pack-clasico.png" alt="Paquete Kichar sabor Clásico" />

  <img class="capa t4" src="/img/pack-hot-chili.png" alt="" data-fg />
  <img class="capa t2" src="/img/pack-pimienta.png" alt="" data-fg />

  <img class="capa d-numeral" src="/img/elem/1.png" alt="" aria-hidden="true" />
  <img class="capa d-estrella" src="/img/elem/3.png" alt="" aria-hidden="true" />
  <img class="capa d-garabato" src="/img/elem/2.png" alt="" aria-hidden="true" />

  <img class="capa t1" src="/img/pack-clasico.png" alt="" data-fg />
  <img class="capa t3" src="/img/pack-ajo.png" alt="" data-fg />

  <div class="slogan pill">CARNE POSTA, VERSIÓN SNACK</div>
</section>

<style>
.hero {
  position: relative;
  height: 100svh;
  min-height: 600px;
  overflow: hidden;
  background: var(--crema);
}

.hero .fondo {
  position: absolute;
  inset: auto 0 0 0;
  height: 42%;
  background: var(--dorado);
  z-index: 0;
}

.hero .marca {
  position: absolute;
  left: 0;
  right: 0;
  top: 12%;
  text-align: center;
  display: flex;
  justify-content: center;
}

.hero .marca img {
  width: clamp(300px, 48vw, 680px);
  height: auto;
}

.hero .pouch {
  display: none;
}

.hero .slogan {
  position: absolute;
  left: 50%;
  bottom: 7%;
  translate: -50% 0;
  font-size: clamp(1rem, 2.2vw, 1.7rem);
  white-space: nowrap;
  --c: var(--crema);
  color: var(--tinta);
}

.capa {
  position: absolute;
  pointer-events: none;
  will-change: transform;
}

.t1 { width: clamp(130px, 17vw, 260px); left: 6%;  top: 62%; z-index: 2; }
.t2 { width: clamp(120px, 14vw, 220px); right: 6%; top: 22%; z-index: 2; }
.t3 { width: clamp(110px, 13vw, 200px); right: 12%; bottom: -4%; z-index: 2; }
.t4 { width: clamp(90px, 10vw, 160px);  left: 20%; top: 16%; z-index: 2; }

.d-estrella {
  width: clamp(70px, 8vw, 120px);
  right: 22%; top: 30%;
  mix-blend-mode: multiply;
}
.d-garabato {
  width: clamp(90px, 10vw, 150px);
  left: 24%; bottom: 14%;
  mix-blend-mode: multiply;
}
.d-numeral {
  width: clamp(60px, 6vw, 90px);
  left: 7%; top: 30%;
  mix-blend-mode: multiply;
}

@media (max-width: 640px) {
  .hero .pouch { top: 62%; }
  .d-estrella, .d-numeral { display: none; }
}
</style>
