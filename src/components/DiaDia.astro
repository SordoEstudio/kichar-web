---
const cartas = [
  {
    i: 0, c: "var(--dorado)", titulo: "Entrenamiento",
    pack: "/img/pack-clasico.png", alt: "Clásico",
    fotos: [
      { src: "https://picsum.photos/seed/gym01/500/380", slot: 1 },
      { src: "https://picsum.photos/seed/gym02/500/380", slot: 2 },
      { src: "https://picsum.photos/seed/gym03/500/380", slot: 3 },
    ],
  },
  {
    i: 1, c: "var(--ajo)", titulo: "Trabajo",
    pack: "/img/pack-ajo.png", alt: "Ajo",
    fotos: [
      { src: "https://picsum.photos/seed/work01/500/380", slot: 1 },
      { src: "https://picsum.photos/seed/work02/500/380", slot: 2 },
      { src: "https://picsum.photos/seed/work03/500/380", slot: 3 },
    ],
    postit: "ABRÍ,\nPICÁ\nY SEGUÍ",
  },
  {
    i: 2, c: "var(--pimienta)", titulo: "Viajes",
    pack: "/img/pack-pimienta.png", alt: "Pimienta",
    fotos: [
      { src: "https://picsum.photos/seed/travel01/500/380", slot: 1 },
      { src: "https://picsum.photos/seed/travel02/500/380", slot: 2 },
      { src: "https://picsum.photos/seed/travel03/500/380", slot: 3 },
    ],
  },
  {
    i: 3, c: "var(--picante)", titulo: "Aire libre",
    pack: "/img/pack-picante.png", alt: "Picante",
    fotos: [
      { src: "https://picsum.photos/seed/nature01/500/380", slot: 1 },
      { src: "https://picsum.photos/seed/nature02/500/380", slot: 2 },
      { src: "https://picsum.photos/seed/nature03/500/380", slot: 3 },
    ],
    postit: "CARNE\nPOSTA",
  },
];
---
<section class="dia wrap" id="dia">
  <div class="dia-cab">
    <span class="pill" style="--c:var(--chili)">Kichar en tu día a día</span>
    <h2 class="disp" style="margin-top:14px;font-size:clamp(2.2rem,4vw,3.2rem)">Va donde vas</h2>
  </div>

  <div class="mazo">
    {cartas.map((c) => (
      <div class="carta" style={`--i:${c.i};--c:${c.c}`}>
        <div class="fotos">
          {c.fotos.map((f) => (
            <figure class={`polo polo-${f.slot}`}>
              <img src={f.src} alt="" loading="lazy" />
            </figure>
          ))}
          {c.postit && <div class="postit">{c.postit}</div>}
        </div>
        <div class="rotulo">
          <span class="disp">{c.titulo}</span>
          <img class="mini" src={c.pack} alt={c.alt} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.dia {
  position: relative;
  padding-block: 60px 80px;
  background: var(--crema);
}

/* ---- Título sticky ---- */
.dia-cab {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--crema);
  padding-block: 20px 14px;
  max-width: 980px;
  margin: 0 auto;
}

.mazo {
  max-width: 980px;
  margin: 32px auto 0;
  display: grid;
  gap: 40px;
}

.carta {
  position: sticky;
  top: calc(110px + var(--i) * 20px);
  height: min(62svh, 520px);
  border-radius: 22px;
  overflow: hidden;
  border: 3px solid var(--tinta);
  background: var(--c);
  transform-origin: 50% 0;
}

/* Cross-hatch texture */
.carta::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient( 45deg, rgba(0,0,0,.06) 0, rgba(0,0,0,.06) 1px, transparent 0, transparent 50%),
    repeating-linear-gradient(-45deg, rgba(0,0,0,.06) 0, rgba(0,0,0,.06) 1px, transparent 0, transparent 50%);
  background-size: 10px 10px;
  pointer-events: none;
  z-index: 0;
}

/* ---- Fotos container ---- */
.fotos {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

/* ---- Polaroids ---- */
.polo {
  position: absolute;
  background: #fff;
  padding: 10px 10px 30px;
  box-shadow: 4px 8px 24px #00000045;
  width: clamp(140px, 20vw, 260px);
}

.polo img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  display: block;
}

.polo-1 { top: 6%;  left: 2%;  rotate: -8deg;  z-index: 2; }
.polo-2 { top: 4%;  right: 2%; rotate:  7deg;  z-index: 2; }
.polo-3 { top: 36%; left: 24%; rotate: -4deg;  z-index: 3; }

/* ---- Post-it ---- */
.postit {
  position: absolute;
  top: 20%;
  right: 6%;
  background: #fef08a;
  padding: 12px 14px 14px;
  font-family: var(--mono);
  font-size: clamp(0.58rem, 1vw, 0.82rem);
  line-height: 1.35;
  white-space: pre-line;
  box-shadow: 2px 3px 10px #00000025;
  max-width: 130px;
  rotate: 4deg;
  z-index: 4;
  color: var(--tinta);
}

/* ---- Rotulo ---- */
.carta .rotulo {
  position: absolute;
  left: 24px;
  bottom: 22px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 12px;
  z-index: 5;
}

.carta .rotulo .disp {
  font-size: clamp(2rem, 6vw, 4.4rem);
  color: var(--tinta);
}

.carta .mini {
  width: clamp(70px, 9vw, 110px);
  rotate: 8deg;
  filter: drop-shadow(0 10px 10px #0003);
}

@media (max-width: 640px) {
  .polo { width: 110px; padding: 8px 8px 24px; }
  .polo-3 { left: 20%; top: 40%; }
  .postit { font-size: 0.55rem; max-width: 100px; right: 4%; }
}
</style>
