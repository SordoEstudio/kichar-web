---
const cartas = [
  {
    i: 0, c: "var(--dorado)", titulo: "Entrenamiento",
    pack: "/img/pack-clasico.png", alt: "Clásico",
    foto: "https://picsum.photos/seed/gymfit/980/520",
    nota: "Abrís el paquete, cargás y seguís.",
  },
  {
    i: 1, c: "var(--ajo)", titulo: "Trabajo",
    pack: "/img/pack-ajo.png", alt: "Ajo",
    foto: "https://picsum.photos/seed/deskwork/980/520",
    nota: "Snack de escritorio sin culpa.",
  },
  {
    i: 2, c: "var(--pimienta)", titulo: "Viajes",
    pack: "/img/pack-pimienta.png", alt: "Pimienta",
    foto: "https://picsum.photos/seed/roadtrip/980/520",
    nota: "Entra en cualquier mochila.",
  },
  {
    i: 3, c: "var(--picante)", titulo: "Aire libre",
    pack: "/img/pack-picante.png", alt: "Picante",
    foto: "https://picsum.photos/seed/hikingtrail/980/520",
    nota: "Trekking, bici, pesca. Te sigue.",
  },
];
---
<section class="dia wrap" id="dia">
  <div class="dia-cab">
    <span class="pill" style="--c:var(--chili)">Kichar en tu día a día</span>
    <h2 class="disp" style="margin-top:14px;font-size:clamp(2.2rem,4vw,3.2rem)">Va donde vas</h2>
  </div>

  <div class="mazo">
    {cartas.map((c) => (
      <div class="carta" style={`--i:${c.i};--c:${c.c}`}>
        <div class="foto">
          <img src={c.foto} alt="" loading="lazy" />
          <em>{c.nota}</em>
        </div>
        <div class="rotulo">
          <span class="disp">{c.titulo}</span>
          <img class="mini" src={c.pack} alt={c.alt} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.dia {
  position: relative;
  padding-block: 60px 80px;
  background: var(--crema);
}

/* ---- Título sticky ---- */
.dia-cab {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--crema);
  padding-block: 20px 14px;
  max-width: 980px;
  margin: 0 auto;
}

.mazo {
  max-width: 980px;
  margin: 32px auto 0;
  display: grid;
  gap: 40px;
}

.carta {
  position: sticky;
  top: calc(110px + var(--i) * 20px);
  height: min(62svh, 520px);
  border-radius: 22px;
  overflow: hidden;
  border: 3px solid var(--tinta);
  background: var(--c);
  transform-origin: 50% 0;
}

/* ---- Foto de fondo ---- */
.carta .foto {
  position: absolute;
  inset: -12% 0;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.carta .foto img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: .55;
  mix-blend-mode: multiply;
}

/* Cross-hatch texture overlay */
.carta .foto::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    135deg,
    rgba(0,0,0,.08) 0 14px,
    transparent      14px 28px
  );
  pointer-events: none;
}

.carta .foto em {
  position: relative;
  z-index: 2;
  font-family: var(--mono);
  font-style: normal;
  font-size: clamp(9px, 0.85vw, 12px);
  background: #fef08a;
  padding: 10px 14px;
  border-radius: 2px;
  max-width: 72%;
  text-align: center;
  color: var(--tinta);
  box-shadow: 2px 3px 0 rgba(0,0,0,.18), 4px 6px 12px rgba(0,0,0,.12);
  rotate: -2deg;
  line-height: 1.5;
}

/* ---- Rotulo ---- */
.carta .rotulo {
  position: absolute;
  left: 24px;
  bottom: 22px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 12px;
  z-index: 5;
}

.carta .rotulo .disp {
  font-size: clamp(2rem, 6vw, 4.4rem);
  color: var(--tinta);
}

.carta .mini {
  width: clamp(70px, 9vw, 110px);
  rotate: 8deg;
  filter: drop-shadow(0 10px 10px #0003);
}

@media (max-width: 640px) {
  .carta .foto em { font-size: 11px; max-width: 85%; }
}
</style>
