---
const cartas = [
  { i: 0, c: "var(--dorado)",   titulo: "Entrenamiento", pack: "/img/pack-clasico.png",  alt: "Clásico",  foto: "https://picsum.photos/seed/gym001/900/600" },
  { i: 1, c: "var(--ajo)",      titulo: "Trabajo",       pack: "/img/pack-ajo.png",       alt: "Ajo",      foto: "https://picsum.photos/seed/office01/900/600" },
  { i: 2, c: "var(--pimienta)", titulo: "Viajes",        pack: "/img/pack-pimienta.png",  alt: "Pimienta", foto: "https://picsum.photos/seed/travel01/900/600" },
  { i: 3, c: "var(--picante)",  titulo: "Aire libre",    pack: "/img/pack-picante.png",   alt: "Picante",  foto: "https://picsum.photos/seed/outdoor01/900/600" },
];
---
<section class="dia wrap" id="dia">
  <div class="dia-intro">
    <span class="pill" style="--c:var(--chili)">Kichar en tu día a día</span>
    <h2 class="disp" style="margin-top:18px">Va donde vas</h2>
  </div>

  <div class="mazo">
    {cartas.map((c) => (
      <div class="carta" style={`--i:${c.i};--c:${c.c}`}>
        <div class="foto">
          <img src={c.foto} alt="" loading="lazy" />
        </div>
        <div class="rotulo">
          <span class="disp">{c.titulo}</span>
          <img class="mini" src={c.pack} alt={c.alt} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.dia {
  position: relative;
  padding-block: 120px 80px;
}

.dia-intro {
  max-width: 980px;
  margin: 0 auto;
}

.mazo {
  max-width: 980px;
  margin: 48px auto 0;
  display: grid;
  gap: 40px;
}

.carta {
  position: sticky;
  top: calc(80px + var(--i) * 18px);
  height: min(62svh, 520px);
  border-radius: 22px;
  overflow: hidden;
  border: 3px solid var(--tinta);
  background: var(--c);
  transform-origin: 50% 0;
}

.carta .foto {
  position: absolute;
  inset: -12% 0;
  overflow: hidden;
}

.carta .foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  mix-blend-mode: multiply;
  opacity: .75;
}

.carta .rotulo {
  position: absolute;
  left: 24px;
  bottom: 22px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 12px;
}

.carta .rotulo .disp {
  font-size: clamp(2rem, 6vw, 4.4rem);
  color: var(--tinta);
}

.carta .mini {
  width: clamp(70px, 9vw, 110px);
  rotate: 8deg;
  filter: drop-shadow(0 10px 10px #0003);
}
</style>
